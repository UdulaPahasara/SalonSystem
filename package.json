{
  "name": "salon-system",
  "version": "1.0.0",
  "private": true,
  "description": "Salon Management System — monolithic Spring Boot + React",
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "dev": "npm run start --prefix frontend",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run start:api\" \"npm run dev\"",
    "start": "npm run start --prefix frontend",
    "start:api": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; ./mvnw spring-boot:run -DskipTests -Dskip.frontend.build=true'",
    "start:prod": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; java -jar target/SalonManagementSystem-0.0.1-SNAPSHOT.jar'",
    "build": "./build.sh",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
