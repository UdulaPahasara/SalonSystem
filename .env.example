# Copy this file to .env and edit values for your machine:
#   cp .env.example .env
#
# MySQL server connection (NOT app login users — those are in DataSeeder.java)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=SalonMangement
DB_USERNAME=root
DB_PASSWORD=

# Optional: server port (Spring Boot reads SPRING_ prefixed vars)
# SERVER_PORT=8081

# Optional: fill an empty database with sample data on start (see README "Demo data")
# SALON_SEED_DEMO_DATA=true

# Security — set these before putting the system on a real server
# Secret used to sign sign-in tokens. Use a long random string; changing it signs everyone out.
# APP_SECRET=
# How long a sign-in lasts, in hours (default 12)
# APP_TOKEN_HOURS=12
# Browser origins allowed to call the API directly (comma separated). Not needed when React is served by the JAR.
# APP_CORS_ORIGINS=http://localhost:3000
# Time zone the salon runs in (default Asia/Colombo)
# APP_TIMEZONE=Asia/Colombo
# Set to true once to reset the five default staff passwords back to Malroo@123
# SALON_RESET_DEFAULT_PASSWORDS=false
# Loyalty: one point per this many rupees spent by a member (default 100)
# SALON_LOYALTY_RS_PER_POINT=100
